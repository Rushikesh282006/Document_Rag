# Environment Mode
ENVIRONMENT=development
DEBUG=True

# Application
PROJECT_NAME="Multi-Tenant RAG API"
API_V1_STR="/api/v1"

# Security & JWT
SECRET_KEY="change-me-super-secret-key-production-ready"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL with pgvector (asyncpg driver for async SQLAlchemy)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage for Raw Uploads
UPLOAD_DIR="./uploads"

# AI / LLM Configuration
# LLM Providers: 'google', 'openai', or 'groq'
GOOGLE_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Embedding Providers: 'google', 'openai', or 'huggingface'
HUGGINGFACE_API_KEY=""
HUGGINGFACE_EMBEDDING_MODEL="BAAI/bge-base-en-v1.5"

EMBEDDING_MODEL_PROVIDER="huggingface" # 'google', 'openai', or 'huggingface'
LLM_MODEL_PROVIDER="groq"              # 'google', 'openai', or 'groq'
EMBEDDING_DIMENSION=768                # 768 for Gemini & BAAI/bge-base-en-v1.5, 1536 for OpenAI
