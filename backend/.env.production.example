# =======================================================
# Production Environment Configuration
# =======================================================

# Application & Environment
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="Multi-Tenant Document RAG Platform"
API_V1_STR="/api/v1"

# Allowed CORS Origins (Comma-separated list of your production frontend domains)
# Example: https://rag.yourdomain.com,https://app.yourdomain.com
BACKEND_CORS_ORIGINS=https://rag.yourdomain.com

# Security & JWT (Generate a 64-char random key: openssl rand -hex 32)
SECRET_KEY=generate-a-strong-random-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# PostgreSQL (pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=use-a-strong-database-password-here
POSTGRES_DB=rag_prod_db

# Storage
UPLOAD_DIR=/app/uploads

# Workers & Concurrency
WEB_CONCURRENCY=4
CELERY_CONCURRENCY=4

# AI / LLM Configuration
# Choose 'google', 'openai', or 'groq' for LLM
LLM_MODEL_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# Choose 'google', 'openai', or 'huggingface' for Embeddings
EMBEDDING_MODEL_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768

# Your API Keys (Set the ones corresponding to your providers)
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=your-production-groq-api-key
HUGGINGFACE_API_KEY=your-production-huggingface-token
